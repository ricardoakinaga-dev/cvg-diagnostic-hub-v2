[Unit]
Description=CVG host backup, WAL, container and idle worker metrics
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/cvg-hub/monitor-agent.env
WorkingDirectory=/opt/cvg-diagnostic-hub-v2
ExecStart=/usr/bin/node /opt/cvg-diagnostic-hub-v2/scripts/monitoring-host-collector.mjs
TimeoutStartSec=90
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cvg-monitoring/textfile
RestrictAddressFamilies=AF_UNIX
UMask=0022
