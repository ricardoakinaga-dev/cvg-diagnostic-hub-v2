#!/usr/sbin/nft -f
# PROD-309 (D-051): host firewall of the hospital server. Only 80/443 are reachable from the clinical network; SSH and
# every other administrative access only from the VPN/bastion subnet. Copy to /etc/nftables.conf, replace the
# placeholders, `nft -f /etc/nftables.conf`, then `systemctl enable nftables`. Docker manages its own chains
# (DOCKER-USER); the published ports of the Compose stack are still filtered by this input chain because Compose binds
# them on the host (HTTP_BIND, HTTPS_PORT). Nothing else in the stack publishes a port (asserted by scripts/backup-wal.test.mjs).
#
# Placeholders (never real addresses in git):
#   10.8.0.0/24.example   subnet of the VPN or the bastion host
#   10.10.0.0/16.example  clinical network of the hospital (workstations that use the Hub)
#   eth0.example          interface facing the hospital network

flush ruleset

table inet filter {
  set admin_sources {
    type ipv4_addr
    flags interval
    elements = { 10.8.0.0/24.example }
  }
  set hub_clients {
    type ipv4_addr
    flags interval
    elements = { 10.10.0.0/16.example, 10.8.0.0/24.example }
  }

  chain input {
    type filter hook input priority 0; policy drop;

    ct state established,related accept
    iif lo accept
    ct state invalid drop
    ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } accept
    ip6 nexthdr icmpv6 accept

    # Administration: SSH only from the VPN/bastion. No other administrative port is open (Docker API, PostgreSQL,
    # MinIO, ClamAV and the scanner are never published by the Compose files).
    tcp dport 22 ip saddr @admin_sources accept

    # The Hub: HTTPS for the clinical network; 80 only for the redirect to HTTPS (and the ACME challenge when the
    # certificate comes from a public CA, which needs 80 reachable from the issuer).
    tcp dport 443 ip saddr @hub_clients accept
    tcp dport 80 ip saddr @hub_clients accept

    # Homologation on the same server (DEPLOYMENT section 13): a second edge on another port, VPN only.
    tcp dport 8443 ip saddr @admin_sources accept

    # Prometheus scrape of /api/v1/metrics goes through 443 with the bearer token; no extra port.
    counter drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
    # Docker inserts its own forward rules for the Compose networks; container-to-container traffic stays inside them.
    ct state established,related accept
    oifname "docker0" accept
    iifname { "docker0", "br-*" } accept
  }

  chain output {
    type filter hook output priority 0; policy accept;
    # Outbound stays open: freshclam (database.clamav.net), the ACME issuer, the image registry (release pull model,
    # DEPLOYMENT section 11), the off-site destination (rclone) and the WhatsApp API when enabled. Restrict to those
    # destinations if the hospital's policy requires egress filtering.
  }
}
