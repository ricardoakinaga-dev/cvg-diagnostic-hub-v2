NODE_ENV=development
APP_DATA_MODE=memory
REALTIME_NOTIFICATION_ADAPTER=process-local
REALTIME_NOTIFICATION_CHANNEL=cvg_realtime_wakeup
REALTIME_LISTEN_POOL_MAX=2
DEMO_PASSWORD=replace-with-a-unique-synthetic-password
ALLOW_SYNTHETIC_SEED=false
ALLOW_DB_SMOKE_RESET=false
ALLOW_RELATIONAL_BACKFILL=false
RELATIONAL_BACKFILL_TARGET=RELATIONAL_SHADOW
RELATIONAL_BACKFILL_RUN_ID=
RELATIONAL_BACKFILL_BATCH_SIZE=25
JSON_BODY_MAX_BYTES=1048576
JSON_BODY_MAX_DEPTH=32
APP_PORT=3000
# Development only: extra LAN origins allowed to load dev assets, comma
# separated (e.g. 192.168.15.14). Never set this in production.
NEXT_ALLOWED_DEV_ORIGINS=
DATABASE_URL=postgresql://cvg:cvg_dev@localhost:54329/cvg_diagnostics
DB_POOL_MAX=10
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
STORAGE_MODE=local
STORAGE_ROOT=.data/uploads
STORAGE_SCAN_MODE=local
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_API_KEY=
MALWARE_SCANNER_ALLOWED_HOSTS=
MALWARE_SCANNER_TIMEOUT_MS=10000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cvg-attachments
STORAGE_ACCESS_KEY=replace-with-storage-access-key
STORAGE_SECRET_KEY=replace-with-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_UPLOAD_RATE_LIMIT=30
LOGIN_RATE_LIMIT=10
RATE_LIMIT_MODE=memory
OUTBOX_INLINE_LOCAL=false
TRUST_PROXY=false
TRUST_PROXY_SHARED_SECRET=
REALTIME_STREAM_MAX_MS=0
# Session idle timeout (ms). 0/negative/unset falls back to 30 minutes.
# Product decision: see docs/DECISION_LOG.md (SESSION_IDLE_TIMEOUT_2026-10).
SESSION_IDLE_TIMEOUT_MS=1800000
# How often an active session may refresh its liveness row (ms). Must stay well
# below SESSION_IDLE_TIMEOUT_MS. Refreshes are one narrow UPSERT outside the
# runtime snapshot; they never lock the aggregate state row.
SESSION_ACTIVITY_TOUCH_INTERVAL_MS=60000
# Runtime retention windows (ms) applied by `npm run runtime:retention` and by
# the outbox worker on its own cadence (RUNTIME_RETENTION_INTERVAL_MS).
SESSION_RETENTION_MS=86400000
IDEMPOTENCY_RETENTION_MS=86400000
OUTBOX_STATE_RETENTION_MS=86400000
STATE_OUTBOX_HOT_WINDOW=100
RUNTIME_RETENTION_INTERVAL_MS=3600000
# Clinical archive (PROD-501, D5): completed requests older than this leave the
# active aggregate. 0 disables archiving. The purge stays off until the legal
# retention period is defined: ARCHIVE_PURGE_AFTER_MONTHS empty or 0 = never.
ARCHIVE_ACTIVE_MONTHS=24
ARCHIVE_INTERVAL_MS=86400000
ARCHIVE_PURGE_AFTER_MONTHS=
# Realtime: full aggregate reads shared by every connection of this process.
REALTIME_SHARED_READ_MIN_INTERVAL_MS=1000
REALTIME_SHARED_NOTIFY_DEBOUNCE_MS=0
# Outbox worker liveness probe (container healthcheck).
OUTBOX_HEARTBEAT_FILE=/tmp/outbox-worker-heartbeat.json
OUTBOX_HEARTBEAT_MAX_AGE_MS=30000
OUTBOX_HEARTBEAT_ERROR_TOLERANCE=3
CRITICAL_POLICY_ENABLED=false
CRITICAL_POLICY_VERSION=
CRITICAL_POLICY_APPROVAL_REF=
CRITICAL_POLICY_APPROVED_AT=
