# Production environment for docker-compose.prod.yml.
# Copy to .env.production (never commit it) and fill every value from your
# secret manager. Generate secrets with: openssl rand -hex 32

# Public hostname served by the TLS edge (DNS must point here for ACME).
APP_DOMAIN=
HTTP_BIND=0.0.0.0
IMAGE_PREFIX=cvg-hub
IMAGE_TAG=latest

# PostgreSQL (container in the stack). Use a managed instance by overriding
# DATABASE_URL in docker-compose.prod.yml if preferred.
POSTGRES_DB=cvg_production
POSTGRES_USER=cvg
POSTGRES_PASSWORD=

# 32+ random characters each. Rotating TRUST_PROXY_SHARED_SECRET requires
# restarting proxy and app together.
SESSION_SECRET=
TRUST_PROXY_SHARED_SECRET=

# S3-compatible object storage for attachments (bucket must already exist;
# `npm run storage:init` can create it on MinIO-style endpoints).
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# External malware scanner (HTTPS is mandatory in production).
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_API_KEY=
MALWARE_SCANNER_ALLOWED_HOSTS=

# First deploy only (`--profile bootstrap run --rm bootstrap`). Remove the
# password from this file and from the secret store after the first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administração
BOOTSTRAP_ADMIN_PASSWORD=

# Critical-result policy stays disabled until clinically approved.
CRITICAL_POLICY_ENABLED=false
CRITICAL_POLICY_VERSION=
CRITICAL_POLICY_APPROVAL_REF=
CRITICAL_POLICY_APPROVED_AT=
