# Production environment for docker-compose.prod.yml.
# Copy to /etc/cvg-hub/<env>.env (never commit it). One file per environment: homologation (cvg-hml) and production
# (cvg-prod) never share an env file, a secrets directory, a database, a bucket or a Compose project (PROD-301).
#
# Secrets (PROD-302, D-051): with docker-compose.secrets.yml (and the on-prem overlay) every secret comes from a FILE in
# SECRETS_DIR (bash scripts/secrets-init.sh <dir>) and the NAME= lines below stay EMPTY; a NAME set together with its file
# is refused by the processes. Without the secrets overlay (managed services, env-file mode) fill the values here from
# the secret manager, generated with: openssl rand -hex 32

# Public hostname served by the TLS edge (DNS must point here for ACME).
APP_DOMAIN=
HTTP_BIND=0.0.0.0
IMAGE_PREFIX=cvg-hub
IMAGE_TAG=latest

# PostgreSQL (container in the stack). POSTGRES_USER/PASSWORD is the ADMINISTRATIVE
# role: only the one-shot migrate service uses it, to create the two roles below.
# The app and the worker connect as POSTGRES_RUNTIME_USER (DML only). Use four
# different secrets; none of them may be reused as the SESSION_SECRET.
POSTGRES_DB=cvg_production
POSTGRES_USER=cvg
POSTGRES_PASSWORD=

# 32+ random characters each. Rotating TRUST_PROXY_SHARED_SECRET requires
# restarting proxy and app together.
SESSION_SECRET=
TRUST_PROXY_SHARED_SECRET=

# S3-compatible object storage for attachments (bucket must already exist;
# `npm run storage:init` can create it on MinIO-style endpoints).
# On-prem (D11, docker-compose.onprem.yml, DEPLOYMENT section 11): STORAGE_ENDPOINT=http://storage:9000,
# STORAGE_FORCE_PATH_STYLE=true, STORAGE_BUCKET=cvg-attachments; the access key pair becomes the MinIO root user.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# External malware scanner (HTTPS is mandatory in production).
# On-prem: MALWARE_SCANNER_ENDPOINT=https://scanner:9443/scan and MALWARE_SCANNER_ALLOWED_HOSTS=scanner; the API key
# (32+ characters) is shared with the scanner container by the overlay.
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_API_KEY=
MALWARE_SCANNER_ALLOWED_HOSTS=

# On-prem overlay only (PROD-307/308, docker-compose.onprem.yml). ONPREM_DIR holds the internal CA, the scanner
# certificate and the MinIO encryption key written by `bash scripts/onprem-init.sh` (outside git; back the key up with
# the database passwords: without it no attachment can be read). The bucket lifecycle (D-050) never expires a current
# object: STORAGE_NONCURRENT_VERSION_DAYS keeps the previous version of a deleted or replaced object for that many days
# (ransomware / mistaken delete window).
ONPREM_DIR=./.data/onprem
MINIO_IMAGE_TAG=7aac2a2
MC_IMAGE_TAG=7394ce0
STORAGE_MEM_LIMIT=1g
CLAMAV_MEM_LIMIT=2g
STORAGE_NONCURRENT_VERSION_DAYS=30
# Secret files of this environment (docker-compose.secrets.yml and the on-prem overlay): bash scripts/secrets-init.sh <dir>.
SECRETS_DIR=/etc/cvg-hub/prod/secrets
# Least privilege on MinIO (D-051): the root user only in storage/storage-init/storage-iam (password in
# SECRETS_DIR/storage_root_password); STORAGE_ACCESS_KEY is the app/worker user (SECRETS_DIR/storage_secret_key) and
# OFFSITE_STORAGE_ACCESS_KEY the read-only user of the off-site copy (SECRETS_DIR/offsite_storage_secret_key).
STORAGE_ROOT_USER=cvg-root
OFFSITE_STORAGE_ACCESS_KEY=cvg-offsite
# uid:gid the scanner container runs as; it must read ONPREM_DIR/certs/scanner.key (onprem-init.sh --owner UID:GID).
SCANNER_UID=1000
SCANNER_GID=1000

# First deploy only (`--profile bootstrap run --rm bootstrap`). Leave the
# password EMPTY to receive a one-time reset link instead (recommended, PROD-202):
# the bootstrap prints it once and the first login happens through it. If you do
# set a password, remove it from this file and from the secret store after the
# first login; the change of the bootstrap password is mandatory either way.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administração
BOOTSTRAP_ADMIN_PASSWORD=

# Least-privilege database roles (PROD-305). The migration role owns the
# schema and is used by `npm run db:migrate` / `npm run db:roles`; the runtime
# role is what the application and worker connect with and must not be able to
# run DDL or modify audit_events. Generate distinct passwords.
POSTGRES_MIGRATION_USER=cvg_migrator
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_USER=cvg_runtime
POSTGRES_RUNTIME_PASSWORD=
# PROD-304: dedicated backup role (cvg_backup, REPLICATION + pg_read_all_data) created by the migrate service.
# pg_basebackup needs REPLICATION, which the runtime role must never hold. Distinct from every other password.
# Empty = no base backups and no PITR (the daily dump keeps working).
POSTGRES_BACKUP_PASSWORD=

# Login budgets per minute: LOGIN_RATE_LIMIT per account (with progressive backoff),
# LOGIN_CLIENT_RATE_LIMIT per client address. Workstations behind one egress
# address (NAT) share the second one, so keep it above the logins of a shift change.
LOGIN_RATE_LIMIT=10
LOGIN_CLIENT_RATE_LIMIT=60

# Password reset link issued by an ADMIN (PROD-202): lifetime in ms, clamped to
# 5 minutes..24 hours. The link is single use and only its hash is stored.
PASSWORD_RESET_TTL_MS=3600000

# Password policy (PROD-203): optional Have I Been Pwned range check. Off by
# default because the server may have restricted internet egress. With `hibp`,
# only the first 5 hex characters of the SHA-1 leave the server. If the service
# cannot be reached, `open` accepts the password (and logs a warning) and
# `closed` rejects with 503.
PASSWORD_BREACH_CHECK=off
PASSWORD_BREACH_CHECK_FAIL=open
PASSWORD_BREACH_CHECK_TIMEOUT_MS=3000

# Aggregated per-account signal (PROD-203/PROD-517): when failed logins for one
# account, summed over every client, reach the threshold inside the window, the
# Hub logs security.login_distributed_attempts, counts it in
# cvg_login_distributed_attempt_signals_total and audits it. It never blocks.
LOGIN_ACCOUNT_SIGNAL_WINDOW_MS=900000
LOGIN_ACCOUNT_SIGNAL_THRESHOLD=20

# PostgreSQL ceilings for app and worker pools: a frozen or partitioned database
# fails requests (503, retryable) instead of holding them indefinitely.
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Session idle timeout and liveness refresh (see docs/operations/DEPLOYMENT.md §6).
# docker-compose.prod.yml forwards every tunable below to the containers.
# A passive monitoring screen receiving SSE counts as activity, so a
# technician watching a queue is not logged out mid-shift.
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ACTIVITY_TOUCH_INTERVAL_MS=60000

# Runtime retention cadence for sessions, idempotency records and processed
# outbox messages. Audited on every run.
RUNTIME_RETENTION_INTERVAL_MS=3600000
RATE_LIMIT_BUCKET_RETENTION_MS=7200000
SESSION_RETENTION_MS=86400000
IDEMPOTENCY_RETENTION_MS=86400000
OUTBOX_STATE_RETENTION_MS=86400000
STATE_OUTBOX_HOT_WINDOW=100

# Clinical archive (PROD-501, D5): months a completed request stays in the active
# aggregate (0 disables archiving) and how often the worker archives. The purge
# deletes archived records and their S3 objects ARCHIVE_PURGE_AFTER_MONTHS after
# archiving; leave it empty until the legal retention period is defined.
ARCHIVE_ACTIVE_MONTHS=24
ARCHIVE_INTERVAL_MS=86400000
ARCHIVE_PURGE_AFTER_MONTHS=

# Realtime read budget: one full aggregate read per process per interval,
# shared by every open stream.
REALTIME_SHARED_READ_MIN_INTERVAL_MS=1000
REALTIME_SHARED_NOTIFY_DEBOUNCE_MS=0

# Outbox worker liveness. A single failed cycle is tolerated; the container is
# reported unhealthy only after OUTBOX_HEARTBEAT_ERROR_TOLERANCE consecutive
# failures. Docker Compose does not restart an unhealthy container by itself.
OUTBOX_HEARTBEAT_FILE=/tmp/outbox-worker-heartbeat.json
OUTBOX_HEARTBEAT_MAX_AGE_MS=30000
OUTBOX_HEARTBEAT_ERROR_TOLERANCE=3

# Critical-result policy stays disabled until clinically approved.
CRITICAL_POLICY_ENABLED=false
CRITICAL_POLICY_VERSION=
CRITICAL_POLICY_APPROVAL_REF=
CRITICAL_POLICY_APPROVED_AT=
# Escalation of an unacknowledged critical result (PROD-402, D3), run by the
# worker: absolute minutes after the release, comma separated, in ms; and the
# recipient ladder, one rule per step after the requester. D3 asks for the
# on-call professional first, e.g. REQUESTER,ON_CALL,RESPONSIBLE,DEPARTMENT_MANAGER.
CRITICAL_POLICY_EFFECTIVE_FROM=
CRITICAL_POLICY_ESCALATION_AFTER_MS=900000,1800000,3600000
CRITICAL_POLICY_RECIPIENT_RULES=REQUESTER,RESPONSIBLE,DEPARTMENT_MANAGER,ON_CALL,ADMIN_FALLBACK
CRITICAL_POLICY_DISTINCT_RECIPIENTS=true

# WhatsApp Business channel of critical results (PROD-402, D3). Keep it off until
# the provider account exists, the UTILITY template is approved by Meta and the
# critical policy above is enabled. The template takes the request protocol as
# body parameter {{1}} and the Hub path as the URL button suffix
# (https://APP_DOMAIN/{{1}}); it never carries clinical data.
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TIMEOUT_MS=10000
# Delivery reports: Meta calls https://APP_DOMAIN/api/v1/webhooks/whatsapp, signed
# with the app secret; the verify token answers the subscription challenge.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_RATE_LIMIT=600
WHATSAPP_WEBHOOK_MAX_BYTES=262144

# Observability (PROD-511): Prometheus scrapes https://APP_DOMAIN/api/v1/metrics
# with this bearer token (32+ characters, distinct from every other secret).
# Leave empty to keep metrics available only to an ADMIN session.
METRICS_SCRAPE_TOKEN=
METRICS_SCRAPE_RATE_LIMIT=60

# Sample accession and label (PROD-405, docs/operations/DEPLOYMENT.md §6.8).
# ACCESSION_PREFIX: 1-4 chars [A-Z0-9] at the start of every generated code
# (<PREFIX><YYMMDD>-<NNNN><C>). LABEL_*_MM: label stock size, 20-150 mm; ask the
# hospital for the printer's label size before changing the defaults.
ACCESSION_PREFIX=A
LABEL_WIDTH_MM=50
LABEL_HEIGHT_MM=30

# Operations: log rotation, memory ceilings and the on-host backup loop.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
# Each process keeps the whole runtime aggregate in memory; size from the data
# volume (DEPLOYMENT §6.6). The heap stays below the container limit.
APP_MEM_LIMIT=2g
APP_HEAP_MB=1280
WORKER_MEM_LIMIT=1g
WORKER_HEAP_MB=768
PROXY_MEM_LIMIT=256m
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Continuous WAL archiving and off-site copy (PROD-304, D2: RPO 15 min, RTO 4 h).
# PostgreSQL closes a WAL segment at least every WAL_ARCHIVE_TIMEOUT_SECONDS; the offsite service ships it every
# OFFSITE_SHIP_INTERVAL_SECONDS, so nominal RPO = 300 + 300 s = 10 min.
WAL_ARCHIVE_TIMEOUT_SECONDS=300
# rclone destination "<remote>:<path>". With the encrypted destination (below, the default) it is offsitecrypt: and the real
# destination goes in OFFSITE_CRYPT_REMOTE. Empty = off-site copy disabled (the stack still starts, but the backups never
# leave the machine: a recorded decision, not an oversight).
# rclone config with the destination credentials: copy deploy/backup/rclone.conf.example, keep it out of git, chmod 600.
OFFSITE_RCLONE_CONFIG=./deploy/backup/rclone.conf
OFFSITE_SHIP_INTERVAL_SECONDS=300
# A shipping cycle is refused (offsite.refused, healthcheck turns red) when /backups has no non-empty dump or base backup
# younger than this; it also stops an empty or wrong volume from being treated as a good backup. Empty = 2 x BACKUP_INTERVAL_SECONDS.
OFFSITE_MAX_BACKUP_AGE_SECONDS=
# Attachments bucket in the off-site copy (PROD-514): rclone path of the bucket, copied write-once to <remote>/objects.
# The on-prem overlay sets it to minio:<STORAGE_BUCKET> and defines the `minio` remote from STORAGE_*; for a managed
# S3 define a remote in rclone.conf and set e.g. OFFSITE_BUCKET_SOURCE=s3-prod:cvg-attachments. Empty = database only.
OFFSITE_BUCKET_SOURCE=
# Encrypted destination (D-051): health data leaves the building only through an rclone `crypt` remote. The service
# defines `offsitecrypt` (names and content encrypted) over OFFSITE_CRYPT_REMOTE, the real destination from rclone.conf
# (s3:cvg-offsite/hospital-a, sftp:/backups/cvg), with the passphrase and salt from SECRETS_DIR (offsite_crypt_password,
# offsite_crypt_salt; env-file mode: OFFSITE_CRYPT_PASSWORD / OFFSITE_CRYPT_SALT here). A destination that is not a crypt
# remote is refused unless OFFSITE_ALLOW_PLAINTEXT=true: a decision of the hospital, recorded, for a destination with
# its own encryption and restricted access. Keep the passphrase in the vault: without it the off-site copy is unreadable.
OFFSITE_RCLONE_REMOTE=offsitecrypt:
OFFSITE_CRYPT_REMOTE=
OFFSITE_CRYPT_PASSWORD=
OFFSITE_CRYPT_SALT=
OFFSITE_ALLOW_PLAINTEXT=false

# TLS edge with the hospital's certificate instead of ACME (PROD-309, docker-compose.internal-tls.yml): full chain and key.
TLS_CERT_FILE=
TLS_KEY_FILE=
