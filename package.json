{
  "name": "cvg-diagnostics-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Central operacional de diagnósticos veterinários",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "node scripts/coverage-report.mjs",
    "test:mutation": "node scripts/mutation-controls.mjs",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "tsx --test scripts/perf-report.test.ts scripts/perf-workload.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:relational-backfill": "tsx scripts/relational-backfill.ts",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "outbox:worker": "tsx scripts/outbox-worker.ts",
    "perf:smoke": "tsx scripts/perf-smoke.ts",
    "perf:synthetic": "tsx scripts/perf-workload.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:restore:smoke": "bash scripts/backup-restore-smoke.sh",
    "test:recovery": "vitest run src/server/operations/recovery-manifest.test.ts",
    "storage:init": "tsx scripts/init-storage.ts",
    "ci:storage-services": "node scripts/ci-storage-services.mjs",
    "validate:docs": "bash scripts/validate-docs.sh",
    "validate:aaa3": "node scripts/validate-aaa3-evidence.mjs",
    "validate:traceability": "node scripts/validate-traceability.mjs",
    "validate:openapi": "redocly lint docs/api/openapi.json --extends=recommended && tsx scripts/validate-openapi.mjs",
    "security:scan": "bash scripts/secret-scan.sh",
    "security:sbom": "npm --silent sbom --sbom-format cyclonedx",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage && npm run validate:docs && npm run validate:openapi && npm run validate:traceability && npm run validate:migrations"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.55.1",
    "@redocly/cli": "2.47.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9.25.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
