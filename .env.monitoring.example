# Independent monitor. Fill every blank with the hospital's actual values; the validator rejects placeholders.
MONITOR_ROLE=external
MONITOR_UID=
MONITOR_GID=
MONITOR_HUB_URL=
MONITOR_AGENT_URL=
MONITOR_HUB_PRIVATE_CA=false
MONITOR_WEBHOOK_PRIVATE_CA=false
MONITOR_CONFIG_DIR=
MONITOR_SECRETS_DIR=
MONITOR_DATA_DIR=
# Application host / monitoring-agent compose and local collector (separate env file).
MONITOR_AGENT_BIND_IP=
CVG_MONITOR_PROJECT=
CVG_MONITOR_TEXTFILE_DIR=/var/lib/cvg-monitoring/textfile
