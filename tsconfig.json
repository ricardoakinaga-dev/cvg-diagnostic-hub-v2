{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@cvg/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@cvg/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@cvg/ui": [
        "./packages/ui/src/index.tsx"
      ],
      "@cvg/services": [
        "./packages/services/src/index.ts"
      ],
      "@cvg/shared-state": [
        "./packages/shared-state/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
